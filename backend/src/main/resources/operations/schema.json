{
  "slug": "pam",
  "title": "特权会话录屏覆盖与超时检查",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "elapsedMinutes",
      "label": "会话已持续分钟",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "10080"
    },
    {
      "key": "approvedMinutes",
      "label": "批准会话分钟",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "10080"
    },
    {
      "key": "recordedMinutes",
      "label": "有效录屏分钟",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "10080"
    },
    {
      "key": "recordingRequired",
      "label": "必须录屏",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "sessionActive",
      "label": "会话仍活动",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    }
  ],
  "columns": [
    {
      "key": "remainingApprovedMinutes",
      "label": "剩余批准分钟"
    },
    {
      "key": "overrunMinutes",
      "label": "超时分钟"
    },
    {
      "key": "missingRecordingMinutes",
      "label": "录屏缺口分钟"
    }
  ],
  "description": "核对已开始会话的时长、批准时限、实际录屏分钟和录屏要求，输出缺失分钟；不接触凭据、不连接主机。",
